rules_version = '2';

// Règles de sécurité du site « Dates d'examen ».
// Seules les personnes qui ont un compte (créé par vous dans Firebase → Authentication
// → Utilisateurs) peuvent lire et modifier les examens.
// L'inscription libre est désactivée (Authentication → Paramètres → Actions des utilisateurs).
service cloud.firestore {
  match /databases/{database}/documents {
    match /dates_examen/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
